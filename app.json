{
  "expo": {
    "name": "Kanek",
    "slug": "kanek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kanek",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#142800"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bz.kanek.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kanek needs your location to show routes and posts near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Kanek needs your location to share your position during active trips.",
        "NSCameraUsageDescription": "Kanek needs camera access for ID verification photos.",
        "NSPhotoLibraryUsageDescription": "Kanek needs photo library access for ID verification uploads.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "bz.kanek.app",
      "adaptiveIcon": {
        "backgroundColor": "#142800",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#142800"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kanek needs your location to share your position during active trips."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kanek needs photo library access for ID verification uploads.",
          "cameraPermission": "Kanek needs camera access for ID verification photos."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "${MAPBOX_DOWNLOAD_TOKEN}"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71a76ae0-95d7-41de-9ce0-b396dc088437"
      }
    }
  }
}
