{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "deviceTest": {
      "channel": "device-test",
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": false
      }
    },
    "storeTest": {
      "channel": "store-test",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "MAPBOX_DOWNLOAD_TOKEN": "${MAPBOX_DOWNLOAD_TOKEN}"
      }
    }
  },
  "submit": {
    "storeTest": {
      "ios": {
        "ascAppId": "6764087212",
        "appleTeamId": "6VR44TAYT7"
      },
      "android": {
        "serviceAccountKeyPath": "./play-store-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
